    "tailwindcss-animate": "1.0.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.4.21",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vite": "7.3.6"
